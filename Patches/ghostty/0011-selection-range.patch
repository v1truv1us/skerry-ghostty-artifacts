+    /// Returns the current selection as content-free surface geometry. The
+    /// renderer mutex keeps the selected range, layout metrics, and content
+    /// scale in one snapshot so embedding hosts never reconstruct endpoints
+    /// from stale or incomplete renderer state. Text remains behind the
+    /// separate read-selection API and never crosses this boundary.
+    export fn ghostty_surface_selection_range(
+        surface: *Surface,
+        result: *SelectionRange,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screen = core_surface.io.terminal.screens.active;
+        const core_sel = screen.selection orelse return false;
+        const leading = screen.pages.pointFromPin(
+            .viewport,
+            core_sel.topLeft(screen),
+        );
+        const trailing = screen.pages.pointFromPin(
+            .viewport,
+            core_sel.bottomRight(screen),
+        );
+
+        const content_scale = core_surface.rt_surface.getContentScale() catch .{
+            .x = 1,
+            .y = 1,
+        };
+        const x_scale = if (content_scale.x > 0) content_scale.x else 1;
+        const y_scale = if (content_scale.y > 0) content_scale.y else 1;
+        const cell_width: f64 = @floatFromInt(core_surface.size.cell.width);
+        const cell_height: f64 = @floatFromInt(core_surface.size.cell.height);
+        const padding_left: f64 = @floatFromInt(core_surface.size.padding.left);
+        const padding_top: f64 = @floatFromInt(core_surface.size.padding.top);
+
+        result.* = .{
+            .leading_x = if (leading) |point|
+                (padding_left + @as(f64, @floatFromInt(point.viewport.x)) * cell_width) / x_scale
+            else
+                0,
+            .leading_y = if (leading) |point|
+                (padding_top + @as(f64, @floatFromInt(point.viewport.y)) * cell_height) / y_scale
+            else
+                0,
+            .trailing_x = if (trailing) |point|
+                (padding_left + @as(f64, @floatFromInt(point.viewport.x + 1)) * cell_width) / x_scale
+            else
+                0,
+            .trailing_y = if (trailing) |point|
+                (padding_top + @as(f64, @floatFromInt(point.viewport.y + 1)) * cell_height) / y_scale
+            else
+                0,
+            .leading_visible = leading != null,
+            .trailing_visible = trailing != null,
+        };
+        return true;
+    }
+
